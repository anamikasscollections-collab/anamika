# =====================================================================
# ANAMIKA COLLECTIONS - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Elegance in Every Thread - Luxury Sarees & Kurtis
# =====================================================================

# Server Environment
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL with Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/anamika_collections?schema=public"

# Authentication Security
JWT_SECRET=anamika_jwt_secret_development_key_change_in_production_2026
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=anamika_admin_jwt_secret_development_key_change_in_prod_2026
ADMIN_JWT_EXPIRES_IN=24h

# Payment Gateway - Razorpay (UPI ONLY)
# Key Secret must NEVER be exposed to frontend or repository
RAZORPAY_KEY_ID=rzp_test_sample_key_id
RAZORPAY_KEY_SECRET=sample_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=sample_razorpay_webhook_secret

# Shipping Provider - Shiprocket
# When empty or invalid, system automatically runs in high-fidelity mock development mode
SHIPROCKET_EMAIL=shipping@anamikacollections.com
SHIPROCKET_PASSWORD=sample_shiprocket_password
SHIPROCKET_API_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_PICKUP_PINCODE=110001
SHIPROCKET_PICKUP_LOCATION=Primary Warehouse Delhi

# Media Storage - Cloudinary
CLOUDINARY_CLOUD_NAME=anamika-media
CLOUDINARY_API_KEY=sample_cloudinary_api_key
CLOUDINARY_API_SECRET=sample_cloudinary_secret

# WhatsApp Business Notification Service (Mock fallback enabled by default)
WHATSAPP_API_TOKEN=sample_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=sample_phone_number_id
WHATSAPP_DEV_MODE=true

# Email Notification Service (SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=sample_smtp_user
SMTP_PASS=sample_smtp_pass
SMTP_FROM="ANAMIKA COLLECTIONS <orders@anamikacollections.com>"
EMAIL_DEV_MODE=true

